    };
    let mut j = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* j) < rvec_len(p.SmtProblem_asserts) {
      * n = sat_add(* n, tr_count(p, * dc, \<llangle>rvec_elems\<rrangle>\<^sub>1(p.SmtProblem_asserts)[* j]));
      * j += 1_usize;
    };
    * n
  \<rbrakk>\<close>

(* Rust: op_width *)
definition "op_width" :: \<open>Op \<Rightarrow> (64 word) \<Rightarrow> (64 word) \<Rightarrow> ('s, 64 word, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>op_width \<equiv> \<lambda>op_v wa wb. FunctionBody \<lbrakk>
    match op_v {
      Op_Concat \<Rightarrow> {
        sat_add(wa, wb)
      },
      Op_Comp | Op_Eq | Op_Distinct \<Rightarrow> {
        1_usize
      },
      Op_Ult | Op_Ule | Op_Ugt | Op_Uge \<Rightarrow> {
        1_usize
      },
      Op_Slt | Op_Sle | Op_Sgt | Op_Sge \<Rightarrow> {
        1_usize
      },
      _ \<Rightarrow> {
        wa
      }
    }
  \<rbrakk>\<close>

(* Rust: stages *)
definition "stages" :: \<open>(64 word) \<Rightarrow> ('s, 64 word, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>stages \<equiv> \<lambda>n. FunctionBody \<lbrakk>
    let mut i = 0_usize;
    let mut p = 1_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while ((* p) < n) && ((* i) < 64_usize) {
      * p = sat_mul(* p, 2_usize);
      * i += 1_usize;
    };
    * i
  \<rbrakk>\<close>

(* Rust: bin_cost *)
definition "bin_cost" :: \<open>Op \<Rightarrow> (64 word) \<Rightarrow> ('s, 64 word, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>bin_cost \<equiv> \<lambda>op_v w. FunctionBody \<lbrakk>
    match op_v {
      Op_Mul | Op_Udiv | Op_Urem | Op_Sdiv | Op_Srem | Op_Smod \<Rightarrow> {
        sat_add(sat_add(sat_mul(sat_mul(76_usize, w), w), sat_mul(300_usize, w)), 20_usize)
      },
      Op_Shl | Op_Lshr | Op_Ashr \<Rightarrow> {
        sat_add(sat_mul(sat_mul(10_usize, w), stages(w)), sat_mul(30_usize, w))
      },
      _ \<Rightarrow> {
        sat_add(sat_mul(30_usize, w), 20_usize)
      }
    }
  \<rbrakk>\<close>

text \<open>Recursive group term_size: defined by iterating term_size_rec_step \<^term>\<open>urust_fuel\<close> times.\<close>

definition "term_size_rec_step" :: \<open>((((64 word) rvec) \<Rightarrow> ((64 word) rvec) \<Rightarrow> Term \<Rightarrow> ('s, ((64 word) \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body)) \<Rightarrow> ((((64 word) rvec) \<Rightarrow> ((64 word) rvec) \<Rightarrow> Term \<Rightarrow> ('s, ((64 word) \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body))\<close> where
  \<open>term_size_rec_step \<equiv> \<lambda>rec_term_size. (\<lambda>ws ds t. FunctionBody \<lbrakk>
    let destr_11 = match t {
      Term_Const(bs) \<Rightarrow> {
        (rvec_len(bs), 0_usize)
      },
      Term_Var(i) \<Rightarrow> {
        (\<llangle>rvec_elems\<rrangle>\<^sub>1(ws)[i], 0_usize)
      },
      Term_Ref(i) \<Rightarrow> {
        (\<llangle>rvec_elems\<rrangle>\<^sub>1(ds)[i], 0_usize)
      },
      Term_Not(a) \<Rightarrow> {
        \<epsilon>\<open>rec_term_size\<close>(ws, ds, a)
      },
      Term_Neg(a) \<Rightarrow> {
        let destr_1 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_1.0;
        let ga = destr_1.1;
        (wa, sat_add(sat_mul(15_usize, wa), ga))
      },
      Term_Bin(op_v, a, b) \<Rightarrow> {
        let destr_2 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_2.0;
        let ga = destr_2.1;
        let destr_3 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, b);
        let wb = destr_3.0;
        let gb = destr_3.1;
        (op_width(op_v, wa, wb), sat_add(bin_cost(op_v, wa), sat_add(ga, gb)))
      },
      Term_Extract(hi, lo, a) \<Rightarrow> {
        let destr_4 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let ga = destr_4.1;
        (sat_add(hi - lo, 1_usize), ga)
      },
      Term_Repeat(i, a) \<Rightarrow> {
        let destr_5 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_5.0;
        let ga = destr_5.1;
        (sat_mul(i, wa), ga)
      },
      Term_ZeroExtend(i, a) \<Rightarrow> {
        let destr_6 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_6.0;
        let ga = destr_6.1;
        (sat_add(wa, i), ga)
      },
      Term_SignExtend(i, a) \<Rightarrow> {
        let destr_7 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_7.0;
        let ga = destr_7.1;
        (sat_add(wa, i), sat_add(sat_mul(5_usize, i), ga))
      },
      Term_RotateLeft(_, a) \<Rightarrow> {
        \<epsilon>\<open>rec_term_size\<close>(ws, ds, a)
      },
      Term_RotateRight(_, a) \<Rightarrow> {
        \<epsilon>\<open>rec_term_size\<close>(ws, ds, a)
      },
      Term_Ite(c, a, b) \<Rightarrow> {
        let destr_8 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, c);
        let gc = destr_8.1;
        let destr_9 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, a);
        let wa = destr_9.0;
        let ga = destr_9.1;
        let destr_10 = \<epsilon>\<open>rec_term_size\<close>(ws, ds, b);
        let gb = destr_10.1;
        (wa, sat_add(sat_mul(5_usize, wa), sat_add(gc, sat_add(ga, gb))))
      }
    };
    let w = destr_11.0;
    let g = destr_11.1;
    (w, sat_add(sat_mul(4_usize, sat_add(w, 1_usize)), g))
  \<rbrakk>)\<close>

(* Rust: term_size *)
definition "term_size" :: \<open>((64 word) rvec) \<Rightarrow> ((64 word) rvec) \<Rightarrow> Term \<Rightarrow> ('s, ((64 word) \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>term_size \<equiv> ((term_size_rec_step ^^ urust_fuel) (\<lambda>ws ds t. FunctionBody \<lbrakk> panic!("out of fuel") \<rbrakk>))\<close>

(* Rust: size_ok *)
definition "size_ok" :: \<open>Problem \<Rightarrow> ('s, bool, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>size_ok \<equiv> \<lambda>q. FunctionBody \<lbrakk>
    let mut ds = { let init_3 = { let res_2 = { let vec_1 = rvec_new(\<llangle>make_elem_layout 8 8\<rrangle>); \<llangle>vec_1 :: (64 word) rvec\<rrangle> }; \<llangle>res_2 :: (64 word) rvec\<rrangle> }; \<llangle>init_3 :: (64 word) rvec\<rrangle> };
    let mut d = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* d) < rvec_len(q.Problem_defs) {
      let destr_4 = term_size(q.Problem_widths, * ds, \<llangle>rvec_elems\<rrangle>\<^sub>1(q.Problem_defs)[* d]);
      let w = destr_4.0;
      rvec_push(ds, w);
      * d += 1_usize;
    };
    let mut n = 1_usize;
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < rvec_len(q.Problem_widths) {
      * n = sat_add(* n, \<llangle>rvec_elems\<rrangle>\<^sub>1(q.Problem_widths)[* i]);
      * i += 1_usize;
    };
    * n = sat_add(* n, rvec_len(q.Problem_widths));
    * n = sat_add(* n, rvec_len(q.Problem_defs));
    * n = sat_add(* n, rvec_len(q.Problem_asserts));
    let mut k = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* k) < rvec_len(q.Problem_defs) {
      let destr_5 = term_size(q.Problem_widths, * ds, \<llangle>rvec_elems\<rrangle>\<^sub>1(q.Problem_defs)[* k]);
      let g = destr_5.1;
      * n = sat_add(* n, g);
      * k += 1_usize;
    };
    let mut j = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* j) < rvec_len(q.Problem_asserts) {
      let destr_6 = term_size(q.Problem_widths, * ds, \<llangle>rvec_elems\<rrangle>\<^sub>1(q.Problem_asserts)[* j]);
      let g = destr_6.1;
      * n = sat_add(* n, g);
      * j += 1_usize;
    };
    sat_mul(4_usize, * n) < cap()
  \<rbrakk>\<close>

(* Rust: check_sat *)
definition "check_sat" :: \<open>SmtProblem \<Rightarrow> ('s, SmtAnswer, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>check_sat \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    if !in_fragment(p) {
      return SmtAnswer_Unknown;
    };
    if tr_size(p) >= cap() {
      return SmtAnswer_Unknown;
    };
    let q = tr_problem(p);
    if !size_ok(q) {
      return SmtAnswer_Unknown;
    };
    match solve(q) {
      Answer_Sat(m) \<Rightarrow> {
        SmtAnswer_Sat_mk(tr_model(p, m))
      },
      Answer_Unsat \<Rightarrow> {
        SmtAnswer_Unsat
      }
    }
  \<rbrakk>\<close>

