            * open = true;
          } else {
            * unit_v = Some(c[* i]);
          }
        }
      };
      * i += 1_usize;
    };
    if * open {
      return Status_Open;
    };
    match * unit_v {
      Some(l) \<Rightarrow> {
        Status_Unit_mk(l)
      },
      None \<Rightarrow> {
        Status_Conflict
      }
    }
  \<rbrakk>\<close>

