(* Rust: cabs *)
definition "cabs" :: \<open>(64 word) \<Rightarrow> (64 word) \<Rightarrow> ('s, CoreTerm, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>cabs \<equiv> \<lambda>k w. FunctionBody \<lbrakk>
    cite(cmsb(k, w), cneg(k, w), cref(k))
  \<rbrakk>\<close>

(* Rust: cslt *)
definition "cslt" :: \<open>(64 word) \<Rightarrow> (64 word) \<Rightarrow> (64 word) \<Rightarrow> ('s, CoreTerm, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>cslt \<equiv> \<lambda>ka kb w. FunctionBody \<lbrakk>
    cbin(BinOp_Or, cbin(BinOp_And, cmsb(ka, w), cnot(cmsb(kb, w))), cbin(BinOp_And, cnot(cbin(BinOp_Xor, cmsb(ka, w), cmsb(kb, w))), cbin(BinOp_Ult, cref(ka), cref(kb))))
  \<rbrakk>\<close>

(* Rust: csle *)
definition "csle" :: \<open>(64 word) \<Rightarrow> (64 word) \<Rightarrow> (64 word) \<Rightarrow> ('s, CoreTerm, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>csle \<equiv> \<lambda>ka kb w. FunctionBody \<lbrakk>
    cbin(BinOp_Or, cbin(BinOp_And, cmsb(ka, w), cnot(cmsb(kb, w))), cbin(BinOp_And, cnot(cbin(BinOp_Xor, cmsb(ka, w), cmsb(kb, w))), cnot(cbin(BinOp_Ult, cref(kb), cref(ka)))))
  \<rbrakk>\<close>

(* Rust: lower_bin *)
definition "lower_bin" :: \<open>Lower \<Rightarrow> Op \<Rightarrow> (64 word) \<Rightarrow> (64 word) \<Rightarrow> ('s, (Lower \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>lower_bin \<equiv> \<lambda>l op_v ka kb. FunctionBody \<lbrakk>
    let w = l.Lower_widths[ka];
    match op_v {
      Op_And \<Rightarrow> {
        push_def(l, cbin(BinOp_And, cref(ka), cref(kb)), w)
      },
      Op_Or \<Rightarrow> {
        push_def(l, cbin(BinOp_Or, cref(ka), cref(kb)), w)
      },
      Op_Xor \<Rightarrow> {
        push_def(l, cbin(BinOp_Xor, cref(ka), cref(kb)), w)
      },
      Op_Nand \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_And, cref(ka), cref(kb))), w)
      },
      Op_Nor \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_Or, cref(ka), cref(kb))), w)
      },
      Op_Xnor \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_Xor, cref(ka), cref(kb))), w)
      },
      Op_Comp \<Rightarrow> {
        push_def(l, cbin(BinOp_Eq, cref(ka), cref(kb)), 1_usize)
      },
      Op_Add \<Rightarrow> {
        push_def(l, cbin(BinOp_Add, cref(ka), cref(kb)), w)
      },
      Op_Sub \<Rightarrow> {
        push_def(l, cbin(BinOp_Add, cref(ka), cneg(kb, w)), w)
      },
      Op_Mul \<Rightarrow> {
        push_def(l, cbin(BinOp_Mul, cref(ka), cref(kb)), w)
      },
      Op_Udiv \<Rightarrow> {
        push_def(l, cbin(BinOp_Udiv, cref(ka), cref(kb)), w)
      },
      Op_Urem \<Rightarrow> {
        push_def(l, cbin(BinOp_Urem, cref(ka), cref(kb)), w)
      },
      Op_Sdiv \<Rightarrow> {
        let destr_1 = push_def(l, cbin(BinOp_Udiv, cabs(ka, w), cabs(kb, w)), w);
        let l = destr_1.0;
        let q = destr_1.1;
        push_def(l, cite(cbin(BinOp_Xor, cmsb(ka, w), cmsb(kb, w)), cneg(q, w), cref(q)), w)
      },
      Op_Srem \<Rightarrow> {
        let destr_2 = push_def(l, cbin(BinOp_Urem, cabs(ka, w), cabs(kb, w)), w);
        let l = destr_2.0;
        let r = destr_2.1;
        push_def(l, cite(cmsb(ka, w), cneg(r, w), cref(r)), w)
      },
      Op_Smod \<Rightarrow> {
        let destr_3 = push_def(l, cbin(BinOp_Urem, cabs(ka, w), cabs(kb, w)), w);
        let l = destr_3.0;
        let u = destr_3.1;
        let destr_4 = push_def(l, cneg(u, w), w);
        let l = destr_4.0;
        let nu = destr_4.1;
        let zero = cbin(BinOp_Eq, cref(u), CoreTerm_Const_mk(vec_from_elem(false, w)));
        let neg_a = cite(cmsb(kb, w), cref(nu), cbin(BinOp_Add, cref(nu), cref(kb)));
        let pos_a = cite(cmsb(kb, w), cbin(BinOp_Add, cref(u), cref(kb)), cref(u));
        push_def(l, cite(zero, cref(u), cite(cmsb(ka, w), neg_a, pos_a)), w)
      },
      Op_Shl \<Rightarrow> {
        push_def(l, cbin(BinOp_Shl, cref(ka), cref(kb)), w)
      },
      Op_Lshr \<Rightarrow> {
        push_def(l, cbin(BinOp_Lshr, cref(ka), cref(kb)), w)
      },
      Op_Ashr \<Rightarrow> {
        push_def(l, cite(cmsb(ka, w), cnot(cbin(BinOp_Lshr, cnot(cref(ka)), cref(kb))), cbin(BinOp_Lshr, cref(ka), cref(kb))), w)
      },
      Op_Concat \<Rightarrow> {
        let wb = l.Lower_widths[kb];
        push_def(l, cbin(BinOp_Concat, cref(ka), cref(kb)), w + wb)
      },
      Op_Eq \<Rightarrow> {
        push_def(l, cbin(BinOp_Eq, cref(ka), cref(kb)), 1_usize)
      },
      Op_Distinct \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_Eq, cref(ka), cref(kb))), 1_usize)
      },
      Op_Ult \<Rightarrow> {
        push_def(l, cbin(BinOp_Ult, cref(ka), cref(kb)), 1_usize)
      },
      Op_Ule \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_Ult, cref(kb), cref(ka))), 1_usize)
      },
      Op_Ugt \<Rightarrow> {
        push_def(l, cbin(BinOp_Ult, cref(kb), cref(ka)), 1_usize)
      },
      Op_Uge \<Rightarrow> {
        push_def(l, cnot(cbin(BinOp_Ult, cref(ka), cref(kb))), 1_usize)
      },
      Op_Slt \<Rightarrow> {
        push_def(l, cslt(ka, kb, w), 1_usize)
      },
      Op_Sle \<Rightarrow> {
        push_def(l, csle(ka, kb, w), 1_usize)
      },
      Op_Sgt \<Rightarrow> {
        push_def(l, cslt(kb, ka, w), 1_usize)
      },
      Op_Sge \<Rightarrow> {
        push_def(l, csle(kb, ka, w), 1_usize)
      }
    }
  \<rbrakk>\<close>

text \<open>Recursive group lower: defined by iterating lower_rec_step \<^term>\<open>urust_fuel\<close> times.\<close>

definition "lower_rec_step" :: \<open>((((64 word) list) \<Rightarrow> ((64 word) list) \<Rightarrow> Lower \<Rightarrow> Term \<Rightarrow> ('s, (Lower \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body)) \<Rightarrow> ((((64 word) list) \<Rightarrow> ((64 word) list) \<Rightarrow> Lower \<Rightarrow> Term \<Rightarrow> ('s, (Lower \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body))\<close> where
  \<open>lower_rec_step \<equiv> \<lambda>rec_lower. (\<lambda>ws dm l t. FunctionBody \<lbrakk>
    match t {
      Term_Const(bits) \<Rightarrow> {
        push_def(l, CoreTerm_Const_mk(bits), len(bits))
      },
      Term_Var(i) \<Rightarrow> {
        push_def(l, CoreTerm_Var_mk(i), ws[i])
      },
      Term_Ref(j) \<Rightarrow> {
        (l, dm[j])
      },
      Term_Not(a) \<Rightarrow> {
        let destr_1 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_1.0;
        let ka = destr_1.1;
        let w = l.Lower_widths[ka];
        push_def(l, cnot(cref(ka)), w)
      },
      Term_Neg(a) \<Rightarrow> {
        let destr_2 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_2.0;
        let ka = destr_2.1;
        let w = l.Lower_widths[ka];
        push_def(l, cneg(ka, w), w)
      },
      Term_Bin(op_v, a, b) \<Rightarrow> {
        let destr_3 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_3.0;
        let ka = destr_3.1;
        let destr_4 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, b);
        let l = destr_4.0;
        let kb = destr_4.1;
        lower_bin(l, op_v, ka, kb)
      },
      Term_Extract(hi, lo, a) \<Rightarrow> {
        let destr_5 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_5.0;
        let ka = destr_5.1;
        push_def(l, cextract(hi, lo, cref(ka)), (hi - lo) + 1_usize)
      },
      Term_Repeat(i, a) \<Rightarrow> {
        let destr_6 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_6.0;
        let ka = destr_6.1;
        let w = l.Lower_widths[ka];
        let destr_8 = push_def(l, CoreTerm_Const_mk({ let res_7 = []; \<llangle>res_7 :: bool list\<rrangle> }), 0_usize);
        let l = destr_8.0;
        let k0 = destr_8.1;
        let mut l = l;
        let mut k = k0;
        let mut acc = 0_usize;
        let mut j = 0_usize;
        #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* j) < i {
          let destr_9 = push_def(* l, cbin(BinOp_Concat, cref(ka), cref(* k)), (* acc) + w);
          let l1 = destr_9.0;
          let k1 = destr_9.1;
          * l = l1;
          * k = k1;
          * acc = (* acc) + w;
          * j += 1_usize;
        };
        (* l, * k)
      },
      Term_ZeroExtend(i, a) \<Rightarrow> {
        let destr_10 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_10.0;
        let ka = destr_10.1;
        let w = l.Lower_widths[ka];
        push_def(l, cbin(BinOp_Concat, CoreTerm_Const_mk(vec_from_elem(false, i)), cref(ka)), w + i)
      },
      Term_SignExtend(i, a) \<Rightarrow> {
        let destr_11 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_11.0;
        let ka = destr_11.1;
        let w = l.Lower_widths[ka];
        let ext = cite(cmsb(ka, w), CoreTerm_Const_mk(vec_from_elem(true, i)), CoreTerm_Const_mk(vec_from_elem(false, i)));
        push_def(l, cbin(BinOp_Concat, ext, cref(ka)), w + i)
      },
      Term_RotateLeft(i, a) \<Rightarrow> {
        let destr_12 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_12.0;
        let ka = destr_12.1;
        let w = l.Lower_widths[ka];
        let r = i % w;
        if r == 0_usize {
          (l, ka)
        } else {
          push_def(l, cbin(BinOp_Concat, cextract((w - 1_usize) - r, 0_usize, cref(ka)), cextract(w - 1_usize, w - r, cref(ka))), w)
        }
      },
      Term_RotateRight(i, a) \<Rightarrow> {
        let destr_13 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_13.0;
        let ka = destr_13.1;
        let w = l.Lower_widths[ka];
        let r = i % w;
        if r == 0_usize {
          (l, ka)
        } else {
          push_def(l, cbin(BinOp_Concat, cextract(r - 1_usize, 0_usize, cref(ka)), cextract(w - 1_usize, r, cref(ka))), w)
        }
      },
      Term_Ite(c, a, b) \<Rightarrow> {
        let destr_14 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, c);
        let l = destr_14.0;
        let kc = destr_14.1;
        let destr_15 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, a);
        let l = destr_15.0;
        let ka = destr_15.1;
        let destr_16 = \<epsilon>\<open>rec_lower\<close>(ws, dm, l, b);
        let l = destr_16.0;
        let kb = destr_16.1;
        let w = l.Lower_widths[ka];
        push_def(l, cite(cref(kc), cref(ka), cref(kb)), w)
      }
    }
  \<rbrakk>)\<close>

(* Rust: lower *)
definition "lower" :: \<open>((64 word) list) \<Rightarrow> ((64 word) list) \<Rightarrow> Lower \<Rightarrow> Term \<Rightarrow> ('s, (Lower \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>lower \<equiv> ((lower_rec_step ^^ urust_fuel) (\<lambda>ws dm l t. FunctionBody \<lbrakk> panic!("out of fuel") \<rbrakk>))\<close>

(* Rust: lower_problem *)
definition "lower_problem" :: \<open>Problem \<Rightarrow> ('s, CoreProblem, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>lower_problem \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    let mut l = Lower_mk { Lower_defs: { let res_1 = []; \<llangle>res_1 :: CoreTerm list\<rrangle> }, Lower_widths: { let res_2 = []; \<llangle>res_2 :: (64 word) list\<rrangle> } };
    let mut dm = { let init_4 = { let res_3 = []; \<llangle>res_3 :: (64 word) list\<rrangle> }; \<llangle>init_4 :: (64 word) list\<rrangle> };
    let mut j = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* j) < len(p.Problem_defs) {
      let destr_5 = lower(p.Problem_widths, * dm, * l, p.Problem_defs[* j]);
      let l1 = destr_5.0;
      let k = destr_5.1;
      * l = l1;
      vec_push(dm, k);
      * j += 1_usize;
    };
    let mut asserts = { let init_7 = { let res_6 = []; \<llangle>res_6 :: CoreTerm list\<rrangle> }; \<llangle>init_7 :: CoreTerm list\<rrangle> };
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(p.Problem_asserts) {
      let destr_8 = lower(p.Problem_widths, * dm, * l, p.Problem_asserts[* i]);
      let l1 = destr_8.0;
      let k = destr_8.1;
      * l = l1;
      vec_push(asserts, cref(k));
      * i += 1_usize;
    };
    CoreProblem_mk { CoreProblem_widths: p.Problem_widths, CoreProblem_defs: * (l.Lower_defs), CoreProblem_asserts: * asserts }
  \<rbrakk>\<close>

(* Rust: solve *)
definition "solve" :: \<open>Problem \<Rightarrow> ('s, Answer, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>solve \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    let q = lower_problem(p);
    solve_core(q)
  \<rbrakk>\<close>

(* Rust: bits1 *)
definition "bits1" :: \<open>bool \<Rightarrow> ('s, bool list, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>bits1 \<equiv> \<lambda>b. FunctionBody \<lbrakk>
    let mut v = { let init_2 = { let res_1 = []; \<llangle>res_1 :: bool list\<rrangle> }; \<llangle>init_2 :: bool list\<rrangle> };
    vec_push(v, b);
    * v
  \<rbrakk>\<close>

(* Rust: tr_push *)
definition "tr_push" :: \<open>Tr \<Rightarrow> Term \<Rightarrow> ('s, (Tr \<times> (64 word) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>tr_push \<equiv> \<lambda>s t. FunctionBody \<lbrakk>
    let k = len(s.Tr_defs);
    let mut defs = { let init_1 = s.Tr_defs; \<llangle>init_1 :: Term list\<rrangle> };
    vec_push(defs, t);
    (Tr_mk { Tr_defs: * defs }, k)
  \<rbrakk>\<close>

(* Rust: tref *)
definition "tref" :: \<open>(64 word) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>tref \<equiv> \<lambda>k. FunctionBody \<lbrakk>
    Term_Ref_mk(k)
  \<rbrakk>\<close>

(* Rust: tbin *)
definition "tbin" :: \<open>Op \<Rightarrow> Term \<Rightarrow> Term \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>tbin \<equiv> \<lambda>op_v a b. FunctionBody \<lbrakk>
    Term_Bin_mk(op_v, a, b)
  \<rbrakk>\<close>

(* Rust: sort_width *)
definition "sort_width" :: \<open>SmtSort \<Rightarrow> ('s, 64 word, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>sort_width \<equiv> \<lambda>s. FunctionBody \<lbrakk>
    match s {
      SmtSort_Bool \<Rightarrow> {
        1_usize
      },
      SmtSort_BitVec(w) \<Rightarrow> {
        w
      },
      SmtSort_Uninterpreted(_) \<Rightarrow> {
        0_usize
      }
    }
  \<rbrakk>\<close>

(* Rust: in_fragment *)
definition "in_fragment" :: \<open>SmtProblem \<Rightarrow> ('s, bool, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>in_fragment \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    if (p.SmtProblem_num_sorts) != 0_usize {
      return false;
    };
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(p.SmtProblem_funs) {
      if len(p.SmtProblem_funs[* i].SmtFun_args) != 0_usize {
        return false;
      };
      * i += 1_usize;
    };
    true
  \<rbrakk>\<close>

(* Rust: tr_op *)
definition "tr_op" :: \<open>SmtOp \<Rightarrow> ('s, Op, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>tr_op \<equiv> \<lambda>o_v. FunctionBody \<lbrakk>
    match o_v {
      SmtOp_And | SmtOp_Bvand \<Rightarrow> {
        Op_And
      },
      SmtOp_Or | SmtOp_Bvor \<Rightarrow> {
        Op_Or
      },
      SmtOp_Xor | SmtOp_Bvxor \<Rightarrow> {
        Op_Xor
      },
      SmtOp_Bvnand \<Rightarrow> {
        Op_Nand
      },
      SmtOp_Bvnor \<Rightarrow> {
        Op_Nor
      },
      SmtOp_Bvxnor \<Rightarrow> {
        Op_Xnor
      },
      SmtOp_Bvcomp \<Rightarrow> {
        Op_Comp
      },
      SmtOp_Bvadd \<Rightarrow> {
        Op_Add
      },
      SmtOp_Bvsub \<Rightarrow> {
        Op_Sub
      },
      SmtOp_Bvmul \<Rightarrow> {
        Op_Mul
      },
      SmtOp_Bvudiv \<Rightarrow> {
        Op_Udiv
      },
      SmtOp_Bvurem \<Rightarrow> {
        Op_Urem
      },
      SmtOp_Bvsdiv \<Rightarrow> {
        Op_Sdiv
      },
      SmtOp_Bvsrem \<Rightarrow> {
        Op_Srem
      },
      SmtOp_Bvsmod \<Rightarrow> {
        Op_Smod
      },
      SmtOp_Bvshl \<Rightarrow> {
        Op_Shl
      },
      SmtOp_Bvlshr \<Rightarrow> {
        Op_Lshr
      },
      SmtOp_Bvashr \<Rightarrow> {
        Op_Ashr
      },
      SmtOp_Concat \<Rightarrow> {
        Op_Concat
      },
      SmtOp_Eq \<Rightarrow> {
        Op_Eq
      },
      SmtOp_Distinct \<Rightarrow> {
        Op_Distinct
      },
      SmtOp_Bvult \<Rightarrow> {
        Op_Ult
      },
      SmtOp_Bvule \<Rightarrow> {
        Op_Ule
      },
      SmtOp_Bvugt \<Rightarrow> {
        Op_Ugt
      },
      SmtOp_Bvuge \<Rightarrow> {
        Op_Uge
      },
      SmtOp_Bvslt \<Rightarrow> {
        Op_Slt
      },
      SmtOp_Bvsle \<Rightarrow> {
        Op_Sle
      },
      SmtOp_Bvsgt \<Rightarrow> {
        Op_Sgt
      },
      SmtOp_Bvsge \<Rightarrow> {
        Op_Sge
      },
      _ \<Rightarrow> {
        Op_Eq
      }
    }
  \<rbrakk>\<close>

(* Rust: fold_left *)
definition "fold_left_fn" :: \<open>SmtOp \<Rightarrow> ((64 word) list) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>fold_left_fn \<equiv> \<lambda>o_v ks. FunctionBody \<lbrakk>
    let mut acc = tref(ks[0_usize]);
    let mut i = 1_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(ks) {
      * acc = tbin(tr_op(o_v), * acc, tref(ks[* i]));
      * i += 1_usize;
    };
    * acc
  \<rbrakk>\<close>

(* Rust: chain *)
definition "chain" :: \<open>SmtOp \<Rightarrow> ((64 word) list) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>chain \<equiv> \<lambda>o_v ks. FunctionBody \<lbrakk>
    let mut acc = tbin(tr_op(o_v), tref(ks[0_usize]), tref(ks[1_usize]));
    let mut i = 2_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(ks) {
      * acc = tbin(Op_And, * acc, tbin(tr_op(o_v), tref(ks[(* i) - 1_usize]), tref(ks[* i])));
      * i += 1_usize;
    };
    * acc
  \<rbrakk>\<close>

(* Rust: pairwise *)
definition "pairwise" :: \<open>((64 word) list) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>pairwise \<equiv> \<lambda>ks. FunctionBody \<lbrakk>
    let mut acc = tbin(Op_Distinct, tref(ks[0_usize]), tref(ks[1_usize]));
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) < len(ks) {
      let mut j = (* i) + 1_usize;
      #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* j) < len(ks) {
        if ((* i) != 0_usize) || ((* j) != 1_usize) {
          * acc = tbin(Op_And, * acc, tbin(Op_Distinct, tref(ks[* i]), tref(ks[* j])));
        };
        * j += 1_usize;
      };
      * i += 1_usize;
    };
    * acc
  \<rbrakk>\<close>

(* Rust: implies *)
definition "implies" :: \<open>((64 word) list) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>implies \<equiv> \<lambda>ks. FunctionBody \<lbrakk>
    let n = len(ks);
    let mut acc = tref(ks[n - 1_usize]);
    let mut i = n - 1_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (* i) > 0_usize {
      * i -= 1_usize;
      * acc = tbin(Op_Or, Term_Not_mk(tref(ks[* i])), * acc);
    };
    * acc
  \<rbrakk>\<close>

(* Rust: tr_app *)
definition "tr_app" :: \<open>SmtOp \<Rightarrow> ((64 word) list) \<Rightarrow> ('s, Term, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
