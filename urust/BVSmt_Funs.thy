definition "blast_rec_step" :: \<open>((Cnf \<Rightarrow> ((Lit list) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> Term \<Rightarrow> ('s, (Cnf \<times> (Lit list) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body)) \<Rightarrow> ((Cnf \<Rightarrow> ((Lit list) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> Term \<Rightarrow> ('s, (Cnf \<times> (Lit list) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body))\<close> where
  \<open>blast_rec_step \<equiv> \<lambda>rec_blast. (\<lambda>cnf vars defs t. FunctionBody \<lbrakk>
    match t {
      Term_Const(bits) \<Rightarrow> {
        (cnf, bv_const(bits))
      },
      Term_Var(i) \<Rightarrow> {
        (cnf, vars[i])
      },
      Term_Ref(i) \<Rightarrow> {
        (cnf, defs[i])
      },
      Term_Not(a) \<Rightarrow> {
        let destr_1 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, a);
        let cnf = destr_1.0;
        let la = destr_1.1;
        (cnf, bv_not(la))
      },
      Term_Bin(op_v, a, b) \<Rightarrow> {
        let destr_2 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, a);
        let cnf = destr_2.0;
        let la = destr_2.1;
        let destr_3 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, b);
        let cnf = destr_3.0;
        let lb = destr_3.1;
        blast_bin(cnf, op_v, la, lb)
      },
      Term_Extract(hi, lo, a) \<Rightarrow> {
        let destr_4 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, a);
        let cnf = destr_4.0;
        let la = destr_4.1;
        (cnf, bv_extract(la, hi, lo))
      },
      Term_Ite(c, a, b) \<Rightarrow> {
        let destr_5 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, c);
        let cnf = destr_5.0;
        let lc = destr_5.1;
        let destr_6 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, a);
        let cnf = destr_6.0;
        let la = destr_6.1;
        let destr_7 = \<epsilon>\<open>rec_blast\<close>(cnf, vars, defs, b);
        let cnf = destr_7.0;
        let lb = destr_7.1;
        bv_ite(cnf, lc[0_usize], la, lb)
      }
    }
  \<rbrakk>)\<close>

(* Rust: blast *)
definition "blast" :: \<open>Cnf \<Rightarrow> ((Lit list) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> Term \<Rightarrow> ('s, (Cnf \<times> (Lit list) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>blast \<equiv> ((blast_rec_step ^^ urust_fuel) (\<lambda>cnf vars defs t. FunctionBody \<lbrakk> panic!("out of fuel") \<rbrakk>))\<close>

(* Rust: lit_value *)
definition "lit_value" :: \<open>((bool option) list) \<Rightarrow> Lit \<Rightarrow> ('s, bool option, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>lit_value \<equiv> \<lambda>a l. FunctionBody \<lbrakk>
    match a[l.Lit_var] {
      Some(b) \<Rightarrow> {
        Some(b != (l.Lit_neg))
      },
      None \<Rightarrow> {
        None
      }
    }
  \<rbrakk>\<close>

(* Rust: clause_status *)
definition "clause_status" :: \<open>((bool option) list) \<Rightarrow> (Lit list) \<Rightarrow> ('s, Status, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>clause_status \<equiv> \<lambda>a c. FunctionBody \<lbrakk>
    let mut unit_v = None;
    let mut open = false;
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(c) {
      match lit_value(a, c[*i]) {
        Some(lit_1) if lit_1 == true \<Rightarrow> {
          return Status_Satisfied;
        },
        Some(lit_2) if lit_2 == false \<Rightarrow> {
          ()
        },
        None \<Rightarrow> {
          if urust_func_option_is_some(*unit_v) {
            *open = true;
          } else {
            *unit_v = Some(c[*i]);
          }
        }
      };
      *i += 1_usize;
    };
    if *open {
      return Status_Open;
    };
    match *unit_v {
      Some(l) \<Rightarrow> {
        Status_Unit_mk(l)
      },
      None \<Rightarrow> {
        Status_Conflict
      }
    }
  \<rbrakk>\<close>

(* Rust: propagate_pass *)
definition "propagate_pass" :: \<open>((bool option) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> ('s, (((bool option) list) \<times> bool \<times> tnil) option, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>propagate_pass \<equiv> \<lambda>a cs. FunctionBody \<lbrakk>
    let mut a = a;
    let mut changed = false;
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(cs) {
      match clause_status(*a, cs[*i]) {
        Status_Conflict \<Rightarrow> {
          return None;
        },
        Status_Unit(l) \<Rightarrow> {
          *(a[l.Lit_var]) = Some(!(l.Lit_neg));
          *changed = true;
        },
        Status_Satisfied \<Rightarrow> {
          ()
        },
        Status_Open \<Rightarrow> {
          ()
        }
      };
      *i += 1_usize;
    };
    Some((*a, *changed))
  \<rbrakk>\<close>

(* Rust: propagate *)
definition "propagate" :: \<open>((bool option) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> ('s, ((bool option) list) option, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>propagate \<equiv> \<lambda>a cs. FunctionBody \<lbrakk>
    let mut a = a;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] loop {
      match propagate_pass(*a, cs) {
        None \<Rightarrow> {
          return None;
        },
        Some((a1, changed)) \<Rightarrow> {
          if !changed {
            return Some(a1);
          };
          *a = a1;
        }
      }
    };
    panic!("unreachable: diverging expression completed")
  \<rbrakk>\<close>

(* Rust: find_unassigned *)
definition "find_unassigned" :: \<open>((bool option) list) \<Rightarrow> ('s, (64 word) option, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>find_unassigned \<equiv> \<lambda>a. FunctionBody \<lbrakk>
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(a) {
      if urust_func_option_is_none(a[*i]) {
        return Some(*i);
      };
      *i += 1_usize;
    };
    None
  \<rbrakk>\<close>

text \<open>Recursive group dpll: defined by iterating dpll_rec_step \<^term>\<open>urust_fuel\<close> times.\<close>

definition "dpll_rec_step" :: \<open>((((Lit list) list) \<Rightarrow> ((bool option) list) \<Rightarrow> ('s, ((bool option) list) option, 'abort, 'i prompt, 'o prompt_output) function_body)) \<Rightarrow> ((((Lit list) list) \<Rightarrow> ((bool option) list) \<Rightarrow> ('s, ((bool option) list) option, 'abort, 'i prompt, 'o prompt_output) function_body))\<close> where
  \<open>dpll_rec_step \<equiv> \<lambda>rec_dpll. (\<lambda>cs a. FunctionBody \<lbrakk>
    match propagate(a, cs) {
      None \<Rightarrow> {
        None
      },
      Some(a) \<Rightarrow> {
        match find_unassigned(a) {
          None \<Rightarrow> {
            Some(a)
          },
          Some(v) \<Rightarrow> {
            let mut a1 = a;
            *(a1[v]) = Some(true);
            match \<epsilon>\<open>rec_dpll\<close>(cs, *a1) {
              Some(r) \<Rightarrow> {
                Some(r)
              },
              None \<Rightarrow> {
                let mut a2 = a;
                *(a2[v]) = Some(false);
                \<epsilon>\<open>rec_dpll\<close>(cs, *a2)
              }
            }
          }
        }
      }
    }
  \<rbrakk>)\<close>

(* Rust: dpll *)
definition "dpll" :: \<open>((Lit list) list) \<Rightarrow> ((bool option) list) \<Rightarrow> ('s, ((bool option) list) option, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>dpll \<equiv> ((dpll_rec_step ^^ urust_fuel) (\<lambda>cs a. FunctionBody \<lbrakk> panic!("out of fuel") \<rbrakk>))\<close>

(* Rust: read_bits *)
definition "read_bits" :: \<open>((bool option) list) \<Rightarrow> (Lit list) \<Rightarrow> ('s, bool list, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>read_bits \<equiv> \<lambda>a ls. FunctionBody \<lbrakk>
    let mut r = [];
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(ls) {
      vec_push(r, lit_value(a, ls[*i]) == Some(true));
      *i += 1_usize;
    };
    *r
  \<rbrakk>\<close>

(* Rust: read_model *)
definition "read_model" :: \<open>((bool option) list) \<Rightarrow> ((Lit list) list) \<Rightarrow> ('s, (bool list) list, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>read_model \<equiv> \<lambda>a vars. FunctionBody \<lbrakk>
    let mut m = [];
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(vars) {
      vec_push(m, read_bits(a, vars[*i]));
      *i += 1_usize;
    };
    *m
  \<rbrakk>\<close>

(* Rust: encode *)
definition "encode" :: \<open>Problem \<Rightarrow> ('s, (Cnf \<times> ((Lit list) list) \<times> tnil), 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>encode \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    let mut cnf = add_clause(Cnf_mk { Cnf_num_vars: 1_usize, Cnf_clauses: [] }, clause1(lit_const(true)));
    let mut vars = [];
    let mut i = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*i) < len(p.Problem_widths) {
      let destr_1 = bv_fresh(*cnf, p.Problem_widths[*i]);
      let c = destr_1.0;
      let ls = destr_1.1;
      *cnf = c;
      vec_push(vars, ls);
      *i += 1_usize;
    };
    let mut defs = [];
    let mut j = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*j) < len(p.Problem_defs) {
      let destr_2 = blast(*cnf, *vars, *defs, p.Problem_defs[*j]);
      let c = destr_2.0;
      let ls = destr_2.1;
      *cnf = c;
      vec_push(defs, ls);
      *j += 1_usize;
    };
    let mut k = 0_usize;
    #[fuel(\<epsilon>\<open>urust_fuel\<close>)] while (*k) < len(p.Problem_asserts) {
      let destr_3 = blast(*cnf, *vars, *defs, p.Problem_asserts[*k]);
      let c = destr_3.0;
      let ls = destr_3.1;
      *cnf = add_clause(c, clause1(ls[0_usize]));
      *k += 1_usize;
    };
    (*cnf, *vars)
  \<rbrakk>\<close>

(* Rust: solve *)
definition "solve" :: \<open>Problem \<Rightarrow> ('s, Answer, 'abort, 'i prompt, 'o prompt_output) function_body\<close> where
  \<open>solve \<equiv> \<lambda>p. FunctionBody \<lbrakk>
    let destr_1 = encode(p);
    let cnf = destr_1.0;
    let vars = destr_1.1;
    match dpll(cnf.Cnf_clauses, vec_from_elem(None, cnf.Cnf_num_vars)) {
      None \<Rightarrow> {
        Answer_Unsat
      },
      Some(a) \<Rightarrow> {
        Answer_Sat_mk(read_model(a, vars))
      }
    }
  \<rbrakk>\<close>

